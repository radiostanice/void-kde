# misc/dialogrc — Void Linux green-on-black theme
use_colors = ON
use_shadow = OFF

# Base: pure black body, bright white text
screen_color = (WHITE,BLACK,OFF)
shadow_color = (BLACK,BLACK,OFF)
dialog_color = (WHITE,BLACK,OFF)

# Frame + title in Void green
border_color = (GREEN,BLACK,ON)
border2_color = (GREEN,BLACK,ON)
title_color = (GREEN,BLACK,ON)

# Buttons (focused button keeps the green fill, like a Void web button)
button_active_color = (BLACK,GREEN,ON)
button_inactive_color = (WHITE,BLACK,OFF)
button_key_active_color = (BLACK,GREEN,ON)
button_key_inactive_color = (GREEN,BLACK,ON)
button_label_active_color = (BLACK,GREEN,ON)
button_label_inactive_color = (WHITE,BLACK,OFF)

# Input / search boxes
inputbox_color = (WHITE,BLACK,ON)
inputbox_border_color = (GREEN,BLACK,ON)
inputbox_border2_color = (GREEN,BLACK,ON)
searchbox_color = (WHITE,BLACK,ON)
searchbox_title_color = (GREEN,BLACK,ON)
searchbox_border_color = (GREEN,BLACK,ON)
position_indicator_color = (GREEN,BLACK,ON)

# Menu list area
menubox_color = (WHITE,BLACK,OFF)
menubox_border_color = (GREEN,BLACK,ON)
menubox_border2_color = (GREEN,BLACK,ON)

# Unselected rows: bright white, hotkey letter as green accent
item_color = (WHITE,BLACK,ON)
tag_color = (WHITE,BLACK,ON)
tag_key_color = (GREEN,BLACK,ON)

# SELECTED row: bright green on black = max contrast (~15:1) and pure Void
item_selected_color = (GREEN,BLACK,ON)
tag_selected_color = (GREEN,BLACK,ON)
tag_key_selected_color = (GREEN,BLACK,ON)

# Checklist
check_color = (GREEN,BLACK,ON)
check_selected_color = (BLACK,GREEN,ON)

# Arrows / gauge / help
uarrow_color = (GREEN,BLACK,ON)
darrow_color = (GREEN,BLACK,ON)
gauge_color = (BLACK,GREEN,ON)
itemhelp_color = (WHITE,BLACK,OFF)
