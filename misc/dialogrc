# ~/.dialogrc
# Theme: Obsidian Cyan (Custom Dark Mode)
# A sleek, high-contrast dark theme for the Linux dialog utility.

# Base Colors
# Format: color <element> = <foreground>, <background>, <highlight>
# Available colors: black, red, green, yellow, blue, magenta, cyan, white
# Available highlights: normal, bold, reverse, underline, dim, standout

# Main Dialog Box
color dialog = white, black, normal
color title = cyan, black, bold
color border = cyan, black, normal

# Buttons
color button_active = black, cyan, bold
color button_inactive = white, black, normal
color button_key_active = red, cyan, bold
color button_key_inactive = yellow, black, bold
color button_label_active = black, cyan, bold
color button_label_inactive = white, black, normal

# Input Boxes
color inputbox = white, black, normal
color inputbox_border = cyan, black, normal
color searchbox = white, black, normal
color searchbox_border = cyan, black, normal

# Menus and Lists
color menubox = white, black, normal
color menubox_border = cyan, black, normal
color item = white, black, normal
color item_selected = black, cyan, bold

# Tags (Checklists/Radiolists)
color tag = white, black, normal
color tag_selected = black, cyan, bold
color tag_key = yellow, black, bold
color tag_key_selected = red, cyan, bold
color check = white, black, normal
color check_selected = black, cyan, bold

# Position Indicator & Arrows
color position_indicator = cyan, black, bold
color uparrow = cyan, black, bold
color downarrow = cyan, black, bold
color leftarrow = cyan, black, bold
color rightarrow = cyan, black, bold

# Forms (if supported by your dialog version)
color form_text = white, black, normal
color form_border = cyan, black, normal
