#!/bin/sh
set -e
PKGNAME="$1"; VERSION="$2"
[ -x /usr/bin/ukify ] || exit 0

ROOTDIR=""
OUTPUT="${ROOTDIR}/boot/efi/EFI/Linux/void-linux.efi"
STUB="${ROOTDIR}/usr/lib/systemd/boot/efi/linuxx64.efi.stub"
INITRD="${ROOTDIR}/boot/initramfs-${VERSION}.img"

[ -f "$STUB" ]   || { echo "60-ukify: missing $STUB (install systemd-boot-efistub)" >&2; exit 1; }
[ -f "$INITRD" ] || { echo "60-ukify: missing $INITRD" >&2; exit 1; }
mkdir -p "$(dirname "$OUTPUT")"

CMDLINE="loglevel=3"
[ -f "${ROOTDIR}/etc/kernel/cmdline" ] && CMDLINE=$(cat "${ROOTDIR}/etc/kernel/cmdline")

ukify build \
	--linux="${ROOTDIR}/boot/vmlinuz-${VERSION}" \
	--initrd="$INITRD" \
	--output="$OUTPUT" \
	--stub="$STUB" \
	--uname="${VERSION}" \
	--os-release=@/etc/os-release \
	--cmdline="$CMDLINE"

# optional: fallback path for VMs/firmwares that ignore NVRAM entries
mkdir -p "${ROOTDIR}/boot/efi/EFI/boot"
cp -f "$OUTPUT" "${ROOTDIR}/boot/efi/EFI/boot/bootx64.efi"
