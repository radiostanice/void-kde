#!/bin/bash
# void-install-script general library for essential, repeated actions

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\e[1;33m'
NC='\033[0m'

die() {
    echo -e "${RED}$commandFailure${NC}\nInstallation will not proceed."
    exit 1
}

drawDialog() {
    # Simplified backtitle for your custom fork
    dialog --stdout --cancel-label "Skip" --no-mouse --backtitle "Void Linux Custom Installer" "$@"
}

install() {
    xbps-install -Sy -R "$repository" -r /mnt "$@" || die
}

system() {
    chroot /mnt /bin/bash -c "$@" || die
}

setKernelParam() {
    # Modern UKI approach: simply append parameters to the cmdline file
    # The 60-ukify hook will automatically read this when building the EFI stub.
    echo "$1" >> /mnt/etc/kernel/cmdline || die
    kernelparam_update="true"
    return 0
}

enableService() {
    # Enables one or more runit services in the chroot
    for service in "$@"; do
        system "ln -sf /etc/sv/$service /var/service"
    done
    return 0
}
