#!/bin/bash

commandFailure="Copying XBPS keys has failed."

mkdir -p /mnt/var/db/xbps/keys || die
cp /var/db/xbps/keys/* /mnt/var/db/xbps/keys || die

# --- PRE-INSTALL IGNOREPKG CONFIGURATION ---
mkdir -p /mnt/etc/xbps.d

# FIX: Added spaces around !=
if [ "$su" != "sudo" ]; then
    echo "ignorepkg=sudo" >> /mnt/etc/xbps.d/ignore.conf || die
fi

# FIX: Added spaces around !=
if [ "$kernel" != "linux" ] ; then
    echo "ignorepkg=linux" >> /mnt/etc/xbps.d/ignore.conf || die
fi

commandFailure="Base system installation has failed."

XBPS_ARCH=$ARCH install base-system e2fsprogs binutils chrony

if [ "$kernel" != "linux" ] ; then
    install "$kernel"
    system "xbps-remove -RyO linux"
fi

# FIX: Added spaces around =
if [ "$su" = "doas" ]; then
    install opendoas
fi

# UKI & Initramfs Dependencies
commandFailure="UKI/Initramfs package installation has failed."
install efibootmgr ukify systemd-boot-efistub "$initrd"

# FIX: Switch alternatives to tinyramfs if selected.
# linux-base pulls dracut, which owns the 20-initramfs slot by default.
# We must explicitly switch to tinyramfs so it takes over.
if [ "$initrd" = "tinyramfs" ]; then
    system "xbps-alternatives -s tinyramfs" || die "Failed to switch alternatives to tinyramfs"
fi

# FIX: Added spaces around !=
if [ "$repository" != "https://repo-default.voidlinux.org/current" ] && [ "$repository" != "https://repo-default.voidlinux.org/current/musl" ]; then
    xmirror -s "$repository" -r /mnt || { commandFailure="Repository configuration failed."; die ; }
fi

# --- HARDENED FSTAB CONFIGURATION ---
commandFailure="Configuring fstab has failed."

esp_uuid=$(blkid -o value -s UUID "$esp")
root_uuid=$(blkid -o value -s UUID "$format_target")

# 1. Hardened ESP (/boot/efi)
echo "UUID=$esp_uuid /boot/efi vfat rw,nosuid,nodev,noexec,umask=0022,flush 0 2" >> /mnt/etc/fstab || die

# 2. Root Partition (ext4 with hardened flags)
echo "UUID=$root_uuid / ext4 rw,noatime,nodiratime,errors=remount-ro 0 1" >> /mnt/etc/fstab || die

# 3. Hardened tmpfs for /tmp
echo "tmpfs /tmp tmpfs defaults,nosuid,nodev 0 0" >> /mnt/etc/fstab || die

# 4. UKI Kernel Command Line
# Create the directory BEFORE writing to it
mkdir -p /mnt/etc/kernel || die

# FIX: Added spaces around =
if [ "$encryption" = "Yes" ]; then
    luks_uuid=$(blkid -o value -s UUID "$root")
    if [ "$initrd" = "dracut" ]; then
        echo "rd.luks.name=$luks_uuid=void_root root=/dev/mapper/void_root rootfstype=ext4 rw" > /mnt/etc/kernel/cmdline || die
    else
        # tinyramfs reads LUKS info from /etc/tinyramfs/config, not cmdline.
        # Just need root= pointing to the mapper device.
        echo "root=/dev/mapper/void_root rootfstype=ext4 rw" > /mnt/etc/kernel/cmdline || die
    fi
else
    echo "root=UUID=$root_uuid rootfstype=ext4 rw" > /mnt/etc/kernel/cmdline || die
fi

# --- LOCALE & HOSTNAME ---
if [ "$libc" = "glibc" ]; then
    echo "$locale" > /mnt/etc/locale.conf || die
    echo "$libclocale" >> /mnt/etc/default/libc-locales || die
fi
echo "$hostname" > /mnt/etc/hostname || die

# --- NETWORK MANAGER MAC RANDOMIZATION ---
commandFailure="Configuring NetworkManager MAC randomization failed."
mkdir -p /mnt/etc/NetworkManager/conf.d

cat << 'EOF' > /mnt/etc/NetworkManager/conf.d/00-mac-randomize.conf
[device]
wifi.scan-rand-mac-address=yes

[connection]
wifi.mac-address-randomization=1
ethernet.mac-address-randomization=1
EOF

# --- NTS SECURE TIME SYNC ---
commandFailure="Configuring Chrony for NTS has failed."
cat << 'EOF' > /mnt/etc/chrony.conf
pool time.cloudflare.com iburst nts
makestep 1.0 3
rtcsync
logdir /var/log/chrony
log measurements statistics tracking
EOF

enableService chronyd

# --- INSTALL ADDITIONAL APPS ---
if [ -n "$extra_packages" ]; then
    commandFailure="Additional packages installation has failed."
    install $extra_packages
fi

# --- TINYRAMFS & LUKS CONFIGURATION ---
if [ "$encryption" == "Yes" ] && [ "$initrd" == "tinyramfs" ]; then
    commandFailure="Configuring tinyramfs has failed."
    mkdir -p /mnt/etc/tinyramfs || die
    CONFIG_FILE="/mnt/etc/tinyramfs/config"
    touch "$CONFIG_FILE"

    # Detect if disk is an SSD (to enable luks_discard)
    is_ssd=0
    base_disk=$(basename "$diskInput")
    if [ -f "/sys/block/$base_disk/queue/rotational" ]; then
        if [ "$(cat /sys/block/$base_disk/queue/rotational)" -eq 0 ]; then
            is_ssd=1
        fi
    fi

    # Append the 'luks' hook if it's not already there (corrected hook name and delimiter)
    if grep -q "^hooks=" "$CONFIG_FILE"; then
        if ! grep -E "^hooks=.*\bluks\b" "$CONFIG_FILE" >/dev/null; then
            sed -i '/^hooks=/ s/\(.*\)"/\1,luks"/' "$CONFIG_FILE"
        fi
    else
        echo 'hooks="eudev,luks"' >> "$CONFIG_FILE"
    fi

    # Enable LUKS discard for SSDs
    if [ "$is_ssd" -eq 1 ]; then
        echo 'luks_discard=yes' >> "$CONFIG_FILE"
    fi
    
    # tinyramfs needs to know the LUKS root UUID and name to unlock it at boot
    luks_uuid=$(blkid -o value -s UUID "$root")
    echo "luks_root=UUID=$luks_uuid" >> "$CONFIG_FILE" || die
    echo "luks_name=void_root" >> "$CONFIG_FILE" || die
fi

# --- SSD TRIM CONFIGURATION ---
is_ssd=0
base_disk=$(basename "$diskInput")
if [ -f "/sys/block/$base_disk/queue/rotational" ]; then
    if [ "$(cat /sys/block/$base_disk/queue/rotational)" -eq 0 ]; then
        is_ssd=1
    fi
fi

if [ "$is_ssd" -eq 1 ]; then
    commandFailure="Configuring SSD TRIM has failed."
    
    # Install cronie for weekly fstrim (Void recommended over fstab discard)
    install cronie || die

    # Create the weekly cron job
    mkdir -p /mnt/etc/cron.weekly || die
    cat << 'CRON_EOF' > /mnt/etc/cron.weekly/fstrim
#!/bin/sh
fstrim -av
CRON_EOF
    chmod +x /mnt/etc/cron.weekly/fstrim || die
    
    # Enable the cronie runit service
    mkdir -p /mnt/etc/runit/runsvdir/default || die
    ln -sf /etc/sv/cronie /mnt/etc/runit/runsvdir/default/cronie
fi

return 0
