#!/bin/bash
echo "Running setup/disk..."

commandFailure="Disk pre-install wipe has failed."
wipefs --all -f "$diskInput" || die

# Clean partition layout: 512M EFI, remaining space Root
# Using fdisk via echo pipe for maximum compatibility across all util-linux versions
commandFailure="Writing partition table has failed."
(
    echo "g"          # Create a new empty GPT partition table
    echo "n"          # Add a new partition
    echo "1"          # Partition number 1
    echo ""           # First sector (default)
    echo "+512M"      # Last sector (+512M for EFI)
    echo "t"          # Change partition type
    echo "1"          # Partition 1
    echo "1"          # EFI System (hex code EF00)
    echo "n"          # Add a new partition
    echo "2"          # Partition number 2
    echo ""           # First sector (default)
    echo ""           # Last sector (default, uses all remaining space)
    echo "w"          # Write table to disk and exit
) | fdisk -w always "$diskInput" || { commandFailure="Writing partition table to disk has failed." ; die ; }

if [[ "$diskInput" == /dev/nvme* ]] || [[ "$diskInput" == /dev/mmcblk* ]]; then
    idvar="p"
else
    idvar=""
fi

esp="${diskInput}${idvar}1"
root="${diskInput}${idvar}2"

commandFailure="Formatting ESP has failed."
mkfs.fat -F 32 "$esp" || die

# Encryption Support (LUKS2 with argon2id)
if [ "$encryption" == "Yes" ]; then
    commandFailure="Encrypting partition has failed."
    echo -e "${YELLOW}Enter your encryption passphrase:${NC}"
    cryptsetup luksFormat --type luks2 --batch-mode --verify-passphrase --pbkdf argon2id "$root" || die

    echo -e "${YELLOW}Opening encrypted partition...${NC}"
    cryptsetup luksOpen "$root" void_root || die
    format_target="/dev/mapper/void_root"
else
    format_target="$root"
fi

commandFailure="Formatting root as ext4 has failed."
mkfs.ext4 -F "$format_target" || die

commandFailure="Mounting partitions has failed."
mount "$format_target" /mnt || die

mkdir -p /mnt/boot/efi || die
mount "$esp" /mnt/boot/efi || die

for dir in dev proc sys run; do
    mkdir -p /mnt/$dir
    mount --rbind /$dir /mnt/$dir
    mount --make-rslave /mnt/$dir
done || die

return 0
