#!/bin/bash
echo "Running setup/disk..."

# --- CLEANUP PREVIOUS INSTALLATION ---
echo "Cleaning previous installation..."

# 1. Unmount everything first (critical before wiping)
for mount_point in $(lsblk -ln -o MOUNTPOINT "$diskInput" 2>/dev/null | grep -v '^$'); do
    echo "Unmounting $mount_point..."
    umount -f -l "$mount_point" 2>/dev/null || true
done

# 2. Close LUKS containers
for mapper in /dev/mapper/*; do
    [ -e "$mapper" ] || continue
    if lsblk -ln -o PKNAME "$mapper" 2>/dev/null | grep -q "$(basename "$diskInput")"; then
        echo "Closing LUKS $(basename "$mapper")..."
        cryptsetup close "$(basename "$mapper")" 2>/dev/null || true
    fi
done

# 3. Wipe filesystem signatures from the disk and all its partitions
wipefs --all --force "$diskInput" 2>/dev/null || true
for part in "${diskInput}"*; do
    [ -b "$part" ] && wipefs --all --force "$part" 2>/dev/null || true
done

# 4. Zap GPT partition table (clears both primary and backup headers)
if command -v sgdisk >/dev/null 2>&1; then
    sgdisk --zap-all "$diskInput" 2>/dev/null || true
else
    # Fallback: zero out the first 10MB to destroy primary GPT
    dd if=/dev/zero of="$diskInput" bs=1M count=10 status=none 2>/dev/null || true
fi

# 5. Delete partition table via sfdisk as an extra measure
sfdisk --delete "$diskInput" 2>/dev/null || true

# 6. Force kernel to drop old partition cache and recognize changes
blockdev --rereadpt "$diskInput" 2>/dev/null || true
partprobe "$diskInput" 2>/dev/null || true
udevadm settle

# --- WIPE AND PARTITION ---
commandFailure="Disk pre-install wipe has failed."
wipefs --all -f "$diskInput" || die

commandFailure="Writing partition table has failed."
(
    echo "g"          # Create GPT
    echo "n"          # New partition
    echo "1"          # Partition 1
    echo ""           # Default first sector
    echo "+512M"      # 512M for EFI
    echo "t"          # Change type
    echo "1"          # Partition 1
    echo "1"          # EFI System
    echo "n"          # New partition
    echo "2"          # Partition 2
    echo ""           # Default first sector
    echo ""           # Use all remaining space
    echo "w"          # Write
) | fdisk -w always "$diskInput" || { commandFailure="Writing partition table failed." ; die ; }

# Force kernel to recognize new partitions immediately
partprobe "$diskInput" 2>/dev/null || true
udevadm settle

# Set partition variables
if [[ "$diskInput" == /dev/nvme* ]] || [[ "$diskInput" == /dev/mmcblk* ]]; then
    idvar="p"
else
    idvar=""
fi

esp="${diskInput}${idvar}1"
root="${diskInput}${idvar}2"

# Wait for partitions to appear
for i in {1..10}; do
    [ -b "$esp" ] && [ -b "$root" ] && break
    echo "Waiting for partitions... attempt $i"
    sleep 1
done

# Verify partitions exist
[ -b "$esp" ] || { commandFailure="ESP partition $esp does not exist." ; die ; }
[ -b "$root" ] || { commandFailure="Root partition $root does not exist." ; die ; }

# --- FORMAT ESP ---
commandFailure="Formatting ESP has failed."
mkfs.vfat -F 32 "$esp" || die

# --- ENCRYPTION ---
if [ "$encryption" == "Yes" ]; then
    commandFailure="Encrypting partition has failed."
    echo -e "${YELLOW}Enter your encryption passphrase:${NC}"
    
    # Detect if disk is an SSD by checking the rotational flag
    is_ssd=0
    base_disk=$(basename "$diskInput")
    if [ -f "/sys/block/$base_disk/queue/rotational" ]; then
        if [ "$(cat /sys/block/$base_disk/queue/rotational)" -eq 0 ]; then
            is_ssd=1
        fi
    fi

    crypt_options="--type luks2 --batch-mode --verify-passphrase --pbkdf argon2id"
    if [ "$is_ssd" -eq 1 ]; then
        crypt_options="$crypt_options --allow-discards"
    fi

    while : ; do
        cryptsetup luksFormat $crypt_options "$root"
        [ "$?" -eq 0 ] && break
    done

    echo -e "${YELLOW}Opening encrypted partition...${NC}"
    while : ; do
        cryptsetup luksOpen "$root" void_root
        [ "$?" -eq 0 ] && break
    done
    
    format_target="/dev/mapper/void_root"
else
    format_target="$root"
fi

# --- FORMAT ROOT ---
commandFailure="Formatting root as ext4 has failed."
mkfs.ext4 -F "$format_target" || die

# --- MOUNT ---
commandFailure="Mounting partitions has failed."
mount "$format_target" /mnt || die

mkdir -p /mnt/boot/efi || die
mount "$esp" /mnt/boot/efi || die

for dir in dev proc sys run; do
    mkdir -p /mnt/$dir
    mount --rbind /$dir /mnt/$dir
    mount --make-rslave /mnt/$dir
done || die

return 0
