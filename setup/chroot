#!/bin/bash

. "/tmp/libviss" || { echo "/tmp/libviss not found."; exit 1; }
. "/tmp/installerOptions" || { commandFailure="Sourcing installer options failed."; die; }

exitFunction () {
    xbps-reconfigure -fa || { commandFailure="xbps-reconfigure failed."; die; }
    
    # SAFETY ADDITION: Force the new "Void Linux" entry to the top of the UEFI boot order.
    # This prevents stubborn motherboards from ignoring the new UKI entry.
    if [ "$bootloader" = "uki" ]; then
        commandFailure="Setting default boot entry has failed."
        # Replaced the fragile 'while read' loop with a robust awk call
        bootEntry=$(efibootmgr --unicode | grep "Void Linux" | awk '{print $1}' | sed 's/Boot//g' | tr -d '*') || die
        efibootmgr --bootorder "$bootEntry" || die
    fi
    exit 0
}

userPassword() {
    echo -e "${YELLOW}Set password for user $username: ${NC}"
    while :; do passwd "$username"; [ "$?" -eq 0 ] && break; done
    exitFunction
}

rootPassword() {
    echo -e "${YELLOW}Set your root password: ${NC}"
    while :; do passwd root; [ "$?" -eq 0 ] && break; done
    [ -n "$username" ] && userPassword
    exitFunction
}

chown root:root / || die
chmod 755 / || die
[ -e /etc/sv/dbus ] && { ln -s /etc/sv/dbus /var/service || die ; }

# --- SECURE BOOT SETUP ---
if [ "$secureboot" = "Yes" ]; then
    echo "Setting up Secure Boot with sbctl..."
    xbps-install -y sbctl || die "Failed to install sbctl."
    
    # Generate keys if they don't exist
    if [ ! -d /var/lib/sbctl ]; then
        sbctl create-keys || die "Failed to create Secure Boot keys."
        echo -e "${YELLOW}Secure Boot keys generated. You MUST enroll them in your BIOS/UEFI on first boot!${NC}"
    fi
    
    # Create the kernel hook for automatic signing
    # NOTE: Named 70-sbctl-sign so it runs AFTER 60-ukify (lexical order)
    mkdir -p /etc/kernel.d/post-install
    cat <<'HOOK' > /etc/kernel.d/post-install/70-sbctl-sign
#!/bin/sh
# Hook to sign UKI binaries automatically
command -v sbctl >/dev/null || exit 0

# Sign standard vmlinuz UKI files or those in ESP
for bin in /boot/efi/EFI/Linux/*.efi; do
    if [ -f "$bin" ]; then
        sbctl sign -s "$bin"
    fi
done
HOOK
    chmod +x /etc/kernel.d/post-install/70-sbctl-sign
fi

# --- UKI GENERATION & REGISTRATION ---
commandFailure="UKI generation has failed."

# Ensure the UKI output directory exists BEFORE reconfiguring kernel
mkdir -p /boot/efi/EFI/Linux || die

# Copy the ukify hook into place
cp /tmp/60-ukify /etc/kernel.d/post-install/60-ukify || die
chmod 755 /etc/kernel.d/post-install/60-ukify || die

# Dynamically find the installed kernel package (e.g., linux6.18, linux6.12)
# ^linux[0-9] excludes the 'linux'/'linux-lts' metas, linux-base, linux-firmware-*
kernel_pkg=$(xbps-query -l | awk '$1 == "ii" && $2 ~ /^linux[0-9]+\.[0-9]+-/ {print $2}' | sed 's/-[0-9].*//' | head -n 1)
echo "Detected kernel package: $kernel_pkg"
if [ -z "$kernel_pkg" ]; then
    commandFailure="Could not detect installed kernel package."
    die
fi

# Force kernel reconfiguration to trigger initramfs + UKI generation
xbps-reconfigure -f "$kernel_pkg" || die

# Belt and braces: if the targeted reconfigure produced no UKI, reconfigure everything
if [ ! -f "/boot/efi/EFI/Linux/void-linux.efi" ]; then
    echo "No UKI after targeted reconfigure, falling back to xbps-reconfigure -fa"
    xbps-reconfigure -fa || die
fi

# Register the UKI with UEFI NVRAM
efi_label="Void Linux"
efi_stub="/boot/efi/EFI/Linux/void-linux.efi"
if [ -f "$efi_stub" ]; then
    commandFailure="efibootmgr registration failed."
    # Standard EFI paths require backslashes
    efibootmgr --create --label "$efi_label" --disk "$diskInput" --part 1 \
    --loader /EFI/Linux/void-linux.efi || die
else
    commandFailure="UKI stub not found at $efi_stub"
    die
fi

ln -sf /usr/share/zoneinfo/"$timezone" /etc/localtime || die

if [ "$su" = "doas" ]; then
    echo "permit persist :wheel" > /etc/doas.conf || die
    chown root:root /etc/doas.conf || die
    chmod 0400 /etc/doas.conf || die
    ln -sf /usr/bin/doas /usr/bin/sudo || die
fi

# Extract just the locale string (e.g., "en_US.UTF-8") from "LANG=en_US.UTF-8"
sys_locale="${locale#LANG=}"
[ -z "$sys_locale" ] && sys_locale="en_US.UTF-8"

if [ -z "$username" ]; then
    clear; rootPassword
else
    useradd "$username" -m -d /home/"$username" || die
    usermod -aG audio,video,kvm,wheel "$username" || die
    
    cat <<EOF > /home/"$username"/.bash_profile
export CHROMIUM_FLAGS="--ozone-platform-hint=wayland --force-device-scale-factor=1.0"
export GOOGLE_API_KEY="no"
export GOOGLE_DEFAULT_CLIENT_ID="no"
export GOOGLE_DEFAULT_CLIENT_SECRET="no"
export LANG=${sys_locale}
export LC_ALL=${sys_locale}
if [ -z "\$DISPLAY" ] && [ "\$(tty)" = "/dev/tty1" ]; then
    export XDG_RUNTIME_DIR="/run/user/$(id -u)"
    if [ ! -d "$XDG_RUNTIME_DIR" ]; then
        mkdir -p "$XDG_RUNTIME_DIR"
        chmod 700 "$XDG_RUNTIME_DIR"
    fi
    export XDG_SESSION_TYPE=wayland
    export XDG_CURRENT_DESKTOP=KDE
    export QT_QPA_PLATFORM=wayland
    exec dbus-run-session startplasma-wayland
fi
EOF
    
    chown "$username":"$username" /home/"$username"/.bash_profile
    chmod 644 /home/"$username"/.bash_profile
    
    # TTY1 Autologin
    mkdir -p /etc/sv/agetty-tty1
    cat <<RUNEOF > /etc/sv/agetty-tty1/run
#!/bin/sh
exec agetty --autologin $username --noclear tty1 linux
RUNEOF
    chmod +x /etc/sv/agetty-tty1/run
    ln -sf /etc/sv/agetty-tty1 /var/service/agetty-tty1
    
    clear; rootPassword
fi
