#!/bin/bash

# This script is an "orchestrator" for the other scripts that exist in the "setup" directory.

# STRICT CONSTRAINTS: ext4, UKI (No GRUB), KDE Wayland, PipeWire, NetworkManager (with MAC randomization).
# CHOICES: LUKS2 (argon2id) or None, dracut or tinyramfs.

. "$(pwd)/misc/libviss" || { echo "$(pwd)/misc/libviss not found. Cannot continue."; exit 1; }
. "$(pwd)/setup/installer" || { commandFailure="$(pwd)/setup/installer not found. Cannot continue."; die; }

# Catch termination signals and trigger cleanup
trap 'die "Interrupted by user or terminated (SIGINT/SIGTERM)."' INT TERM QUIT

# --- HARDCODED SETTINGS ---
basesystem="base-system"
filesystem="ext4"
bootloader="uki"
network="NetworkManager"
audio="pipewire"
desktop="kde"

drawDialog --msgbox "Welcome!\n\nThis installer is customized for a specific, hardened setup:\n- KDE Plasma (Wayland ONLY)\n- ext4 filesystem only\n- UKI Bootloader only (No GRUB)\n- PipeWire + WirePlumber audio\n- NetworkManager with MAC Randomization\n- Hardened fstab defaults\n\nNo changes will be made to the disk until you confirm." 0 0

# --- 1. DISK SELECTION ---
diskConfig() {
    local diskList
    mapfile -t diskArray < <(lsblk -d -o NAME,SIZE -n -e7)
    if diskInput=$(drawDialog --no-cancel --title "Available Disks" --menu "Choose the disk to install Void Linux to (ALL DATA WILL BE WIPED):" 0 0 0 "${diskArray[@]}"); then
        diskInput="/dev/$diskInput"
    else
        exit 0
    fi
    userConfig
}


# --- 2. USER & HOSTNAME ---
userConfig() {
    # Username: pre-filled default, validated, Cancel/ESC aborts
    while :; do
        if ! username=$(drawDialog --title "Create User" --inputbox \
            "Enter your username:\n(lowercase letters, digits, '-' and '_';\nmust start with a letter or '_')" 0 0 "${username:-user}"); then
            exit 0
        fi
        [ "$username" = "root" ] && username=""
        if [[ "$username" =~ ^[a-z_][a-z0-9_-]*$ ]]; then
            break
        fi
        drawDialog --msgbox "Invalid username: '${username:-<empty>}''.\n\nThe field is pre-filled with a safe default ('user').\nPress OK on it to accept, or type a valid name:\n- starts with a lowercase letter or '_'\n- then lowercase letters, digits, '-' or '_'" 0 0
    done

    # Hostname: same idea (RFC 1123-ish, 1-63 chars)
    while :; do
        if ! hostname=$(drawDialog --title "System Hostname" --inputbox \
            "Enter your system hostname:\n(letters, digits, '-' and '_'; no spaces or dots)" 0 0 "${hostname:-user}"); then
            exit 0
        fi
        if [[ "$hostname" =~ ^[a-zA-Z0-9]([a-zA-Z0-9_-]{0,62}[a-zA-Z0-9])?$ ]]; then
            break
        fi
        drawDialog --msgbox "Invalid hostname: '${hostname:-<empty>}''.\n\nUse 1-63 characters: letters, digits, '-' or '_',\nstarting and ending with a letter or digit.\nThe field is pre-filled with the default ('user')." 0 0
    done
    timezoneConfig
}

# --- 3. DYNAMIC TIMEZONE ---
timezoneConfig() {
    local areas=(Africa America Antarctica Arctic Asia Atlantic Australia Europe Indian Pacific)
    local menu_args=() a
    for a in "${areas[@]}"; do menu_args+=("$a" ""); done

    local area location
    if area=$(drawDialog --no-cancel --title "Set Timezone" \
            --menu "Select your region:" 0 0 0 "${menu_args[@]}"); then

        mapfile -t locations < <(find "/usr/share/zoneinfo/$area" -type f -printf '%P\n' 2>/dev/null | sort)
        local display_locations=("${locations[@]//_/ }")

        local loc_args=() l
        for l in "${display_locations[@]}"; do loc_args+=("$l" ""); done
        location=$(drawDialog --no-cancel --title "Set Timezone" \
                --menu "Select your location:" 0 0 0 "${loc_args[@]}")
        location="${location// /_}"
    fi

    if [ -n "$area" ] && [ -n "$location" ]; then
        timezone="$area/$location"
    else
        timezone="UTC"
    fi
    localeConfig
}

# --- 4. DYNAMIC LOCALE ---
localeConfig() {
    local localeList
    localeList=$(grep -F '.UTF-8' /etc/default/libc-locales | awk '{print $1}' | sed -e 's/^#//' | sort -u)
    local tmp=()
    local i
    for i in $localeList; do
        tmp+=("$i" "")     # empty description -> single column, no repeated text
    done
    local localeChoice
    localeChoice=$(drawDialog --no-cancel --title "Locale Selection" --menu "Please choose your system locale." 0 0 0 "${tmp[@]}")
    locale="LANG=$localeChoice"
    libclocale="$localeChoice UTF-8"
    repositoryConfig
}

# --- 5. REPOSITORY MIRROR (Restored xmirror) ---
repositoryConfig() {
    if drawDialog --title "Repository Mirror" --defaultno --yesno "Would you like to set a custom repo mirror?\n\nIf 'No', the Fastly CDN repo will be used." 0 0 ; then
        xmirror
        repository=$(grep -h '^repository=' /etc/xbps.d/*-repository-main.conf 2>/dev/null | head -n 1 | cut -d= -f2 | tr -d '[:space:]')
    else
        # Use Fastly CDN as default instead of repo-default
        [ "$libc" = "glibc" ] && repository="https://repo-fastly.voidlinux.org/current"
        [ "$libc" = "musl" ] && repository="https://repo-fastly.voidlinux.org/current/musl"
    fi
    
    [ "$libc" = "glibc" ] && ARCH="x86_64"
    [ "$libc" = "musl" ] && ARCH="x86_64-musl"
    
    encryptionConfig
}

# --- 6. ENCRYPTION CHOICE ---
encryptionConfig() {
    if drawDialog --title "Disk Encryption" --yesno "Do you want to encrypt the root partition with LUKS2 (argon2id)?\n\nIf 'No', the partition will be unencrypted." 0 0 ; then
        encryption="Yes"
    else
        encryption="No"
    fi
    suConfig
}

# --- 7. PRIVILEGE ESCALATION CHOICE ---
suConfig() {
    su=$(drawDialog --no-cancel --title "Privilege Escalation" --menu "Choose your privilege escalation tool:" 0 0 0 \
    "sudo" "- Standard, widely used privilege escalation" \
    "doas" "- Lightweight, secure alternative (OpenBSD style)")
    kernelConfig
}

# --- 8. KERNEL SELECTION ---
kernelConfig() {
    kernel=$(drawDialog --no-cancel --title "Kernel Selection" --menu "Select your Linux kernel:" 0 0 0 \
    "linux" "- Standard latest stable kernel" \
    "linux-lts" "- Long Term Support kernel (recommended for stability)")
    initrdConfig
}

# --- 9. INITRAMFS CHOICE ---
initrdConfig() {
    initrd=$(drawDialog --no-cancel --title "Initramfs Choice" --menu "Select your initramfs generator:" 0 0 0 \
    "dracut" "- Default, robust Void initramfs generator" \
    "tinyramfs" "- Small, fast POSIX Shell initramfs generator")
    gpuConfig
}

# --- 10. GPU SELECTION ---
gpuConfig() {
    graphics=$(drawDialog --no-cancel --title "GPU Driver Selection" --menu "Select your GPU driver:\n(Note: Auto-detect can be inaccurate in VMs)" 0 0 0 \
    "auto" "- Auto-detect (lspci)" \
    "amd" "- AMD / Radeon" \
    "intel" "- Intel" \
    "nvidia" "- NVIDIA (Proprietary)" \
    "nvidia-nouveau" "- NVIDIA (Open-source Nouveau)" \
    "none" "- Generic / VM Display (virtio, qxl, vmware)")
    
    if [ "$graphics" = "auto" ]; then
        local gpu_info
        gpu_info=$(lspci -nn | grep -Ei "vga|3d|display")
        if echo "$gpu_info" | grep -qi "nvidia"; then
            graphics="nvidia"
        elif echo "$gpu_info" | grep -Eiq "radeon|amd|ati"; then
            graphics="amd"
        elif echo "$gpu_info" | grep -qi "intel"; then
            graphics="intel"
        else
            graphics="none"
        fi
    fi
    securebootConfig
}

# --- 11. SECURE BOOT ---
securebootConfig() {
    if drawDialog --title "Secure Boot" --yesno "Do you want to generate Secure Boot keys and sign the kernel?\n\nThis installs 'sbctl' and adds a kernel hook to automatically sign kernels on updates." 0 0 ; then
        secureboot="Yes"
    else
        secureboot="No"
    fi
    appsConfig
}

# --- 12. ADDITIONAL APPLICATIONS CHECKLIST ---
appsConfig() {
    local apps_list=(
        "dolphin" "KDE File Manager" on
        "konsole" "KDE Terminal" on
        "kinfocenter" "KDE About this System page" on
        "octoxbps" "OctoXBPS package manager" on
        "ark" "KDE archive manager" on
        "kate" "KDE advanced text editor" on
        "oxygen" "KDE theme - Recommended" on
        "spectacle" "KDE screenshot capture utility" on
        "chromium" "Chromium web browser" off
        "firefox" "Firefox web browser" off
        "flatpak" "Flatpak package management" off
        "htop" "System monitor" off
        "blueman" "Bluetooth GUI manager" off
        "cups" "CUPS printing support" off
    )

    # Define the core apps that are ON by default
    local required_defaults=("dolphin" "konsole" "kinfocenter" "octoxbps" "ark" "kate")

    local selected
    selected=$(drawDialog --no-cancel --title "Additional Applications" --checklist "Select optional packages to install (Space to select, Enter to confirm):" 0 0 0 "${apps_list[@]}")
    extra_packages=$(echo "$selected" | tr -d '"')

    # Check for deselected default apps and warn the user
    local missing_apps=()
    for app in "${required_defaults[@]}"; do
        # Check if the required app is NOT present in the user's selected string
        if [[ ! "$extra_packages" == *"$app"* ]]; then
            missing_apps+=("$app")
        fi
    done

    # If the missing_apps array has at least 1 item, show the warning
    if [ ${#missing_apps[@]} -gt 0 ]; then
        drawDialog --title "WARNING: Missing Core Apps" --msgbox "You have disabled the following default applications:\n\n${missing_apps[*]}\n\nDisabling these core KDE apps might result in a broken or degraded desktop experience!" 0 0
    fi

    # Existing Confirmation screen to verify selected packages
    if [ -n "$extra_packages" ]; then
        drawDialog --title "Selected Packages" --msgbox "The following packages will be installed:\n\n$extra_packages" 0 0
    else
        drawDialog --title "Selected Packages" --msgbox "No additional packages were selected." 0 0
    fi

    confirm
}

# --- 13. CONFIRMATION ---
confirm() {
    local settings="Target disk: $diskInput (WILL BE WIPED)\n"
    settings+="Filesystem: ext4\n"
    settings+="Encryption: $encryption\n"
    settings+="Bootloader: UKI (No GRUB)\n"
    settings+="Kernel: $kernel\n"
    settings+="Initramfs: $initrd\n"
    settings+="Desktop: KDE Plasma (Wayland only)\n"
    settings+="Audio: PipeWire\n"
    settings+="Network: NetworkManager (MAC Randomization enabled)\n"
    settings+="Hostname: $hostname\n"
    settings+="User: $username\n"
    settings+="Privilege Escalation: $su\n"
    settings+="Timezone: $timezone\n"
    settings+="Locale: ${locale#LANG=}\n"
    settings+="Repo: $repository\n"
    settings+="GPU Driver: $graphics\n"
    settings+="Secure Boot: $secureboot\n"
    [ -n "$extra_packages" ] && settings+="Extra Apps: $extra_packages\n"
    
    if drawDialog --yes-label "Install" --no-label "Exit" --title "Installation Overview" --yesno "Selecting 'Install' will DESTROY ALL DATA on $diskInput and proceed with these options:\n\n$settings" 0 0 ; then
        _install
    else
        exit 0
    fi
}

# --- INSTALLATION EXECUTION ---
_install() {
    exec 3>&1 4>&2
    exec > >(tee -a "$logFile") 2>&1
    {
        echo "void-install-script log"
        echo "date: $(date)"
        echo "commit: $(git -C "$(pwd)" rev-parse --short HEAD 2>/dev/null || echo unknown)"
        echo "environment: ${libc} ${ARCH} $(uname -r)"
        echo ""
        echo "user settings:"
        echo -e "$settings"
        echo ""
    } >> "$logFile"
    
    echo "Starting installation..."
    . "$(pwd)"/setup/disk
    
    # FIX: Ensure /mnt/tmp exists before writing to it
    mkdir -p /mnt/tmp
    
    # Safe heredoc prevents word-splitting issues with variables
    cat <<EOF > /mnt/tmp/installerOptions
bootloader=${bootloader@Q}
su=${su@Q}
timezone=${timezone@Q}
encryption=${encryption@Q}
diskInput=${diskInput@Q}
username=${username@Q}
desktop=${desktop@Q}
root=${root@Q}
initrd=${initrd@Q}
graphics=${graphics@Q}
kernel=${kernel@Q}
secureboot=${secureboot@Q}
EOF
    
    . "$(pwd)"/setup/base
    . "$(pwd)"/setup/desktop
    
    commandFailure="System chroot setup has failed."
    cp /etc/resolv.conf /mnt/etc/resolv.conf || die
    cp -f "$(pwd)"/misc/libviss /mnt/tmp/libviss || die
    cp -f "$(pwd)"/setup/chroot /mnt/tmp/chroot || die
    cp -f "$(pwd)"/misc/60-ukify /mnt/tmp/60-ukify || die
    
    system "/bin/bash /tmp/chroot"
    clear
    system "xbps-remove -RyO"

    # Clean up cached xbps packages from the target disk (no longer needed)
    system "find /var/cache/xbps -name '*.xbps' -delete 2>/dev/null || true"

    exec 1>&3 2>&4
    clear

    # Success path: drop the leftover /tmp log (die() leaves it in /tmp on failure)
    rm -f "$logFile"
    
    # --- SECURE BOOT ENROLLMENT WARNING ---
    if [ "$secureboot" = "Yes" ]; then
        drawDialog --title "!!! CRITICAL: SECURE BOOT !!!" \
                   --msgbox "Custom Secure Boot keys were generated.\n\nYou MUST enter your BIOS/UEFI settings on your FIRST BOOT and enroll these keys (or the hash of the UKI).\n\nIf you do not do this, the system WILL NOT BOOT." 16 60
    fi

    # --- FINAL REBOOT DIALOG ---
    if drawDialog --title "Installation Complete" --yes-label "Reboot" --no-label "Exit" --yesno "Installation finished successfully.\n\nTotal installer runtime: ${SECONDS} seconds." 0 0 ; then
        reboot now
    else
        exit 0
    fi
}

# Start the flow
diskConfig
