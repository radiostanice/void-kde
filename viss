#!/bin/bash

# This script is an "orchestrator" for the other scripts that exist in the "setup" directory.

# STRICT CONSTRAINTS: ext4, UKI (No GRUB), KDE Wayland, PipeWire, NetworkManager (with MAC randomization).
# CHOICES: LUKS2 (argon2id) or None, dracut or tinyramfs.

. "$(pwd)/misc/libviss" || { echo "$(pwd)/misc/libviss not found. Cannot continue."; exit 1; }
. "$(pwd)/setup/installer" || { commandFailure="$(pwd)/setup/installer not found. Cannot continue."; die; }

# Catch termination signals and trigger cleanup
trap 'die "Interrupted by user or terminated (SIGINT/SIGTERM)."' INT TERM QUIT

# --- HARDCODED SETTINGS ---
basesystem="base-system"
filesystem="ext4"
bootloader="uki"
network="NetworkManager"
audio="pipewire"
desktop="kde"

drawDialog --msgbox "Welcome!\n\nThis installer is customized for a specific, hardened setup:\n- KDE Plasma (Wayland ONLY)\n- ext4 filesystem only\n- UKI Bootloader only (No GRUB)\n- PipeWire + WirePlumber audio\n- NetworkManager with MAC Randomization\n- Hardened fstab defaults\n\nNo changes will be made to the disk until you confirm." 0 0

# --- 1. DISK SELECTION ---
diskConfig() {
    local diskArray=() name size
    # Read disk name and size separately to form proper tag/item pairs for the dialog menu
    while read -r name size; do
        [ -n "$name" ] && diskArray+=("$name" "$size")
    done < <(lsblk -d -o NAME,SIZE -n -e7)

    diskInput=$(drawDialogBack --no-cancel --title "Available Disks" --menu "Choose the disk to install Void Linux to (ALL DATA WILL BE WIPED):" 0 0 0 "${diskArray[@]}")
    ret=$?
    if [ $ret -eq 3 ]; then
        exit 0
    elif [ -n "$diskInput" ]; then
        diskInput="/dev/$diskInput"
    else
        exit 0
    fi
    userConfig
}

# --- 2. USER & HOSTNAME ---
userConfig() {
    # Username
    while :; do
        username=$(drawDialogBack --title "Create User" --inputbox \
            "Enter your username:\n(lowercase letters, digits, '-' and '_';\nmust start with a letter or '_')" 0 0 "${username:-user}")
        ret=$?
        if [ $ret -eq 1 ]; then exit 0
        elif [ $ret -eq 3 ]; then diskConfig; return; fi
        
        [ "$username" = "root" ] && username=""
        if [[ "$username" =~ ^[a-z_][a-z0-9_-]*$ ]]; then
            break
        fi
        drawDialog --title "Invalid Username" --msgbox "Invalid username: '${username:-<empty>}'.\n\nThe field is pre-filled with a safe default ('user').\nPress OK on it to accept, or type a valid name:\n- starts with a lowercase letter or '_'\n- then lowercase letters, digits, '-' or '_'" 0 0
    done

    # Hostname
    while :; do
        hostname=$(drawDialogBack --title "System Hostname" --inputbox \
            "Enter your system hostname:\n(letters, digits, '-' and '_'; no spaces or dots)" 0 0 "${hostname:-localhost}")
        ret=$?
        if [ $ret -eq 1 ]; then exit 0
        elif [ $ret -eq 3 ]; then diskConfig; return; fi
        
        if [[ "$hostname" =~ ^[a-zA-Z0-9]([a-zA-Z0-9_-]{0,62}[a-zA-Z0-9])?$ ]]; then
            break
        fi
        drawDialog --title "Invalid Hostname" --msgbox "Invalid hostname: '${hostname:-<empty>}'.\n\nUse 1-63 characters: letters, digits, '-' or '_',\nstarting and ending with a letter or digit.\nThe field is pre-filled with the default ('localhost')." 0 0
    done
    timezoneConfig
}

# --- 3. DYNAMIC TIMEZONE ---
timezoneConfig() {
    local areas=(Africa America Antarctica Arctic Asia Atlantic Australia Europe Indian Pacific)
    local menu_args=() a
    for a in "${areas[@]}"; do menu_args+=("$a" ""); done

    local area location
    area=$(drawDialogBack --no-cancel --title "Set Timezone" --menu "Select your region:" 0 0 0 "${menu_args[@]}")
    ret=$?
    if [ $ret -eq 3 ]; then userConfig; return; fi

    if [ -n "$area" ]; then
        mapfile -t locations < <(find "/usr/share/zoneinfo/$area" -type f -printf '%P\n' 2>/dev/null | sort)
        local display_locations=("${locations[@]//_/ }")
        local loc_args=() l
        for l in "${display_locations[@]}"; do loc_args+=("$l" ""); done
        
        location=$(drawDialogBack --no-cancel --title "Set Timezone" --menu "Select your location:" 0 0 0 "${loc_args[@]}")
        ret=$?
        if [ $ret -eq 3 ]; then userConfig; return; fi
        location="${location// /_}"
    fi

    if [ -n "$area" ] && [ -n "$location" ]; then
        timezone="$area/$location"
    else
        timezone="UTC"
    fi
    localeConfig
}

# --- 4. DYNAMIC LOCALE ---
localeConfig() {
    local localeList tmp=() i localeChoice
    localeList=$(grep -F '.UTF-8' /etc/default/libc-locales | awk '{print $1}' | sed -e 's/^#//' | sort -u)
    for i in $localeList; do tmp+=("$i" ""); done
    
    localeChoice=$(drawDialogBack --no-cancel --title "Locale Selection" --menu "Please choose your system locale." 0 0 0 "${tmp[@]}")
    ret=$?
    if [ $ret -eq 3 ]; then timezoneConfig; return; fi
    
    locale="LANG=$localeChoice"
    libclocale="$localeChoice UTF-8"
    repositoryConfig
}

# --- 5. REPOSITORY MIRROR ---
repositoryConfig() {
    drawDialogBack --title "Repository Mirror" --defaultno --yesno "Would you like to set a custom repo mirror?\n\nIf 'No', the Fastly CDN repo will be used." 0 0
    ret=$?
    if [ $ret -eq 3 ]; then localeConfig; return
    elif [ $ret -eq 0 ]; then
        xmirror
        repository=$(grep -h '^repository=' /etc/xbps.d/*-repository-main.conf 2>/dev/null | head -n 1 | cut -d= -f2 | tr -d '[:space:]')
    else
        [ "$libc" = "glibc" ] && repository="https://repo-fastly.voidlinux.org/current"
        [ "$libc" = "musl" ] && repository="https://repo-fastly.voidlinux.org/current/musl"
    fi
    
    [ "$libc" = "glibc" ] && ARCH="x86_64"
    [ "$libc" = "musl" ] && ARCH="x86_64-musl"
    encryptionConfig
}

# --- 6. ENCRYPTION CHOICE ---
encryptionConfig() {
    drawDialogBack --title "Disk Encryption" --yesno "Do you want to encrypt the root partition with LUKS2 (argon2id)?\n\nIf 'No', the partition will be unencrypted." 0 0
    ret=$?
    if [ $ret -eq 3 ]; then repositoryConfig; return
    elif [ $ret -eq 0 ]; then encryption="Yes"
    else encryption="No"; fi
    suConfig
}

# --- 7. PRIVILEGE ESCALATION CHOICE ---
suConfig() {
    su=$(drawDialogBack --no-cancel --title "Privilege Escalation" --menu "Choose your privilege escalation tool:" 0 0 0 \
    "sudo" "- Standard, widely used privilege escalation" \
    "doas" "- Lightweight, secure alternative (OpenBSD style)")
    ret=$?
    if [ $ret -eq 3 ]; then encryptionConfig; return; fi
    kernelConfig
}

# --- 8. KERNEL SELECTION ---
kernelConfig() {
    kernel=$(drawDialogBack --no-cancel --title "Kernel Selection" --menu "Select your Linux kernel:" 0 0 0 \
    "linux" "- Standard latest stable kernel" \
    "linux-lts" "- Long Term Support kernel (recommended for stability)")
    ret=$?
    if [ $ret -eq 3 ]; then suConfig; return; fi
    kernelParamsConfig
}

# --- 8.1 KERNEL SECURITY PRESETS ---
kernelParamsConfig() {
    preset=$(drawDialogBack --no-cancel --title "Kernel Hardening" --menu "Select a kernel security profile:" 0 0 0 \
    "secure" "- Max Security (CPU mitigations, memory hardening, safe for boot hardened)" \
    "default" "- Default (Good performance with baseline security)" \
    "custom" "- Custom (Manually enter your own parameters)")
    ret=$?
    if [ $ret -eq 3 ]; then kernelConfig; return; fi

    if [ "$preset" = "secure" ]; then
        # Max Security parameters (safe for desktop, avoids aggressive lockdowns that break DKMS/initramfs rescue)
        KERN_PARAMS="mitigations=auto,nosmt spectre_v2=on spec_store_bypass_disable=on l1tf=full,force pti=on init_on_alloc=1 init_on_free=1 slab_debug=FZP slab_nomerge randomize_kstack_offset=on vsyscall=none random.trust_cpu=off random.trust_bootloader=off"
    elif [ "$preset" = "default" ]; then
        # Default parameters (Baseline security with good performance)
        KERN_PARAMS="mitigations=auto pti=on vsyscall=emulate init_on_alloc=1"
    elif [ "$preset" = "custom" ]; then
        while :; do
            KERN_PARAMS=$(drawDialogBack --title "Custom Parameters" --inputbox \
                "Enter custom kernel parameters (space-separated):\n(Leave empty to skip)" 0 0 "")
            ret=$?
            if [ $ret -eq 3 ]; then kernelParamsConfig; return; fi
            if [ -z "${KERN_PARAMS// }" ]; then
                KERN_PARAMS=""
                break
            fi
            drawDialog --yesno "You entered:\n\n$KERN_PARAMS\n\nIs this correct?" 0 0
            if [ $? -eq 0 ]; then break; fi
        done
    fi
    initrdConfig
}

# --- 9. INITRAMFS CHOICE ---
initrdConfig() {
    initrd=$(drawDialogBack --no-cancel --title "Initramfs Choice" --menu "Select your initramfs generator:" 0 0 0 \
    "dracut" "- Default, robust Void initramfs generator" \
    "tinyramfs" "- Small, fast POSIX Shell initramfs generator")
    ret=$?
    if [ $ret -eq 3 ]; then kernelParamsConfig; return; fi
    gpuConfig
}

# --- 10. GPU SELECTION ---
gpuConfig() {
    graphics=$(drawDialogBack --no-cancel --title "GPU Driver Selection" --menu "Select your GPU driver:\n(Note: Auto-detect can be inaccurate in VMs)" 0 0 0 \
    "auto" "- Auto-detect (lspci)" \
    "amd" "- AMD / Radeon" \
    "intel" "- Intel" \
    "nvidia" "- NVIDIA (Proprietary)" \
    "nvidia-nouveau" "- NVIDIA (Open-source Nouveau)" \
    "none" "- Generic / VM Display (virtio, qxl, vmware)")
    ret=$?
    if [ $ret -eq 3 ]; then initrdConfig; return; fi
    
    if [ "$graphics" = "auto" ]; then
        local gpu_info
        gpu_info=$(lspci -nn | grep -Ei "vga|3d|display")
        if echo "$gpu_info" | grep -qi "nvidia"; then
            graphics="nvidia"
        elif echo "$gpu_info" | grep -Eiq "radeon|amd|ati"; then
            graphics="amd"
        elif echo "$gpu_info" | grep -qi "intel"; then
            graphics="intel"
        else
            graphics="none"
        fi
    fi
    securebootConfig
}

# --- 11. SECURE BOOT ---
securebootConfig() {
    drawDialogBack --title "Secure Boot" --yesno "Do you want to generate Secure Boot keys and sign the kernel?\n\nThis installs 'sbctl' and adds a kernel hook to automatically sign kernels on updates." 0 0
    ret=$?
    if [ $ret -eq 3 ]; then gpuConfig; return
    elif [ $ret -eq 0 ]; then secureboot="Yes"
    else secureboot="No"; fi
    appsConfig
}

# --- 12. ADDITIONAL APPLICATIONS CHECKLIST ---
appsConfig() {
    local apps_list=(
        "dolphin" "KDE File Manager" on
        "kinfocenter" "KDE About this System page" on
        "octoxbps" "OctoXBPS package manager" on
        "ark" "KDE archive manager" on
        "kate" "KDE advanced text editor" on
        "oxygen" "KDE theme - Recommended" on
        "spectacle" "KDE screenshot capture utility" on
        "chromium" "Chromium web browser" off
        "firefox" "Firefox web browser" off
        "flatpak" "Flatpak package management" off
        "htop" "System monitor" off
        "blueman" "Bluetooth GUI manager" off
        "cups" "CUPS printing support" off
    )

    local required_defaults=("dolphin" "konsole" "kinfocenter" "octoxbps" "ark" "kate")
    local selected missing_apps=() app

    selected=$(drawDialogBack --no-cancel --title "Additional Applications" --checklist "Select optional packages to install (Space to select, Enter to confirm):" 0 0 0 "${apps_list[@]}")
    ret=$?
    if [ $ret -eq 3 ]; then securebootConfig; return; fi
    
    extra_packages=$(echo "$selected" | tr -d '"')

    for app in "${required_defaults[@]}"; do
        if [[ ! "$extra_packages" == *"$app"* ]]; then
            missing_apps+=("$app")
        fi
    done

    if [ ${#missing_apps[@]} -gt 0 ]; then
        drawDialog --title "WARNING: Missing Core Apps" --msgbox "You have disabled the following default applications:\n\n${missing_apps[*]}\n\nDisabling these core KDE apps might result in a broken or degraded desktop experience!" 0 0
    fi

    if [ -n "$extra_packages" ]; then
        drawDialog --title "Selected Packages" --msgbox "The following packages will be installed:\n\n$extra_packages" 0 0
    else
        drawDialog --title "Selected Packages" --msgbox "No additional packages were selected." 0 0
    fi
    confirm
}

# --- 13. CONFIRMATION ---
confirm() {
    local settings="Target disk: $diskInput (WILL BE WIPED)\n"
    settings+="Filesystem: ext4\n"
    settings+="Encryption: $encryption\n"
    settings+="Bootloader: UKI (No GRUB)\n"
    settings+="Kernel: $kernel\n"
    if [ -n "$KERN_PARAMS" ]; then
        settings+="Kernel Params: $KERN_PARAMS\n"
    else
        settings+="Kernel Params: None\n"
    fi
    settings+="Initramfs: $initrd\n"
    settings+="Desktop: KDE Plasma (Wayland only)\n"
    settings+="Audio: PipeWire\n"
    settings+="Network: NetworkManager (MAC Randomization enabled)\n"
    settings+="Hostname: $hostname\n"
    settings+="User: $username\n"
    settings+="Privilege Escalation: $su\n"
    settings+="Timezone: $timezone\n"
    settings+="Locale: ${locale#LANG=}\n"
    settings+="Repo: $repository\n"
    settings+="GPU Driver: $graphics\n"
    settings+="Secure Boot: $secureboot\n"
    [ -n "$extra_packages" ] && settings+="Extra Apps: $extra_packages\n"
    
    drawDialogBack --yes-label "Install" --no-label "Exit" --title "Installation Overview" --yesno "Selecting 'Install' will DESTROY ALL DATA on $diskInput and proceed with these options:\n\n$settings" 0 0
    ret=$?
    if [ $ret -eq 3 ]; then appsConfig; return
    elif [ $ret -eq 0 ]; then _install
    else exit 0; fi
}

# --- INSTALLATION EXECUTION ---
_install() {
    exec 3>&1 4>&2
    exec > >(tee -a "$logFile") 2>&1
    {
        echo "void-install-script log"
        echo "date: $(date)"
        echo "commit: $(git -C "$(pwd)" rev-parse --short HEAD 2>/dev/null || echo unknown)"
        echo "environment: ${libc} ${ARCH} $(uname -r)"
        echo ""
        echo "user settings:"
        echo -e "$settings"
        echo ""
    } >> "$logFile"
    
    echo "Starting installation..."
    . "$(pwd)"/setup/disk
    
    # FIX: Ensure /mnt/tmp exists before writing to it
    mkdir -p /mnt/tmp
    
    # Safe heredoc prevents word-splitting issues with variables
    cat <<EOF > /mnt/tmp/installerOptions
bootloader=${bootloader@Q}
su=${su@Q}
timezone=${timezone@Q}
encryption=${encryption@Q}
diskInput=${diskInput@Q}
username=${username@Q}
desktop=${desktop@Q}
root=${root@Q}
initrd=${initrd@Q}
graphics=${graphics@Q}
kernel=${kernel@Q}
secureboot=${secureboot@Q}
locale=${locale@Q}
EOF
    
    . "$(pwd)"/setup/base
    . "$(pwd)"/setup/desktop
    
    commandFailure="System chroot setup has failed."
    cp /etc/resolv.conf /mnt/etc/resolv.conf || die
    cp -f "$(pwd)"/misc/libviss /mnt/tmp/libviss || die
    cp -f "$(pwd)"/setup/chroot /mnt/tmp/chroot || die
    cp -f "$(pwd)"/misc/60-ukify /mnt/tmp/60-ukify || die
    
    system "/bin/bash /tmp/chroot"
    clear
    system "xbps-remove -RyO"

    # Clean up cached xbps packages from the target disk (no longer needed)
    system "find /var/cache/xbps -name '*.xbps' -delete 2>/dev/null || true"

    exec 1>&3 2>&4
    clear

    # Success path: drop the leftover /tmp log (die() leaves it in /tmp on failure)
    rm -f "$logFile"
    
    # --- SECURE BOOT ENROLLMENT WARNING ---
    if [ "$secureboot" = "Yes" ]; then
        drawDialog --title "!!! CRITICAL: SECURE BOOT !!!" \
                   --msgbox "Custom Secure Boot keys were generated.\n\nYou MUST enter your BIOS/UEFI settings on your FIRST BOOT and enroll these keys (or the hash of the UKI).\n\nIf you do not do this, the system WILL NOT BOOT." 16 60
    fi

    # --- FINAL REBOOT DIALOG ---
    if drawDialog --title "Installation Complete" --yes-label "Reboot" --no-label "Exit" --yesno "Installation finished successfully.\n\nTotal installer runtime: ${SECONDS} seconds." 0 0 ; then
        reboot
    else
        exit 0
    fi
}

# Start the flow
diskConfig
